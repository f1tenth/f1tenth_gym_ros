<?xml version="1.0"?>

<!--
  GENERATED FILE - DO NOT EDIT BY HAND.

  Written by scripts/usd_to_mesh.py from meshes/roboracer.usd. Re-run that script
  after changing the USD; hand edits here are lost on the next regeneration.
  NOTE - two hand edits below must be folded into usd_to_mesh.py before the
  next regeneration: the wheel-spin structure (back_*_hinge links + continuous
  wheel joints, animated by the gym bridge), and the frame convention (meshes
  placed about the rear axle, no lr shift) plus the gym hitbox as base_link's
  <collision> box. Avoid "colon + space" anywhere
  in this file; unless robot_description is wrapped in ParameterValue, launch
  yaml-parses the URDF string and a colon turns it into a mapping.

  Same link and joint names as urdf/ego_racecar.xacro so TF, the gym bridge and
  anything downstream keep working - only the geometry changed, from primitive
  boxes to the meshes baked out of the USD.
-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="racecar">

  <xacro:arg name="car_name" default="ego_racecar"/>
  <!-- Tints roboracer_accent.stl, which is how ego and opponents are told apart.
       That mesh is STL precisely so this colour is the only one a viewer has. -->
  <xacro:arg name="accent_color" default="0.3 0.57 1.0 1.0"/>
  <!-- One of f1tenth, f1fifth, fullscale. The USD is an F1TENTH car, so the other
       platforms reuse it scaled by the ratio of wheelbases. -->
  <xacro:arg name="vehicle" default="f1tenth"/>

  <xacro:property name="car_name" value="$(arg car_name)"/>
  <xacro:property name="vehicle" value="$(arg vehicle)"/>
  <xacro:if value="${vehicle == 'f1tenth'}">
    <xacro:property name="s" value="${1.000000}"/>
    <xacro:property name="hit_len" value="${0.58}"/>
    <xacro:property name="hit_wid" value="${0.31}"/>
    <xacro:property name="hit_cx" value="${0.1651}"/>
  </xacro:if>
  <xacro:if value="${vehicle == 'f1fifth'}">
    <xacro:property name="s" value="${1.656456}"/>
    <xacro:property name="hit_len" value="${0.8}"/>
    <xacro:property name="hit_wid" value="${0.55}"/>
    <xacro:property name="hit_cx" value="${0.2655}"/>
  </xacro:if>
  <xacro:if value="${vehicle == 'fullscale'}">
    <xacro:property name="s" value="${7.449941}"/>
    <xacro:property name="hit_len" value="${4.298}"/>
    <xacro:property name="hit_wid" value="${1.674}"/>
    <xacro:property name="hit_cx" value="${1.1963}"/>
  </xacro:if>
  <xacro:property name="mesh_dir" value="package://f1tenth_gym_ros/meshes"/>

  <!-- ============================ WHEEL ALIGNMENT ============================
       Per-wheel visual rpy corrections [deg]. All four wheels are baked from the
       same source model but at their posed orientation in the USD scene, so each
       glb carries a slightly different camber+toe tilt off its true axle. Any
       residual angle between the mesh axle and link y wobbles once the bridge
       spins the wheel TF, so the corrections must be exact per wheel - these are
       measured from the mesh geometry by scripts/measure_wheel_alignment.py
       (rerun it and paste new values after re-exporting the meshes). -->
  <xacro:property name="align_fl_deg" value="${[-3.574, 0.068, 2.177]}"/>
  <xacro:property name="align_fr_deg" value="${[1.899, -0.046, 2.803]}"/>
  <xacro:property name="align_rl_deg" value="${[-2.543, -0.005, -0.246]}"/>
  <xacro:property name="align_rr_deg" value="${[2.932, 0.007, -0.290]}"/>
  <!-- =========================================================================== -->
  <xacro:property name="d2r" value="${pi / 180}"/>
  <xacro:property name="align_fl" value="${align_fl_deg[0]*d2r} ${align_fl_deg[1]*d2r} ${align_fl_deg[2]*d2r}"/>
  <xacro:property name="align_fr" value="${align_fr_deg[0]*d2r} ${align_fr_deg[1]*d2r} ${align_fr_deg[2]*d2r}"/>
  <xacro:property name="align_rl" value="${align_rl_deg[0]*d2r} ${align_rl_deg[1]*d2r} ${align_rl_deg[2]*d2r}"/>
  <xacro:property name="align_rr" value="${align_rr_deg[0]*d2r} ${align_rr_deg[1]*d2r} ${align_rr_deg[2]*d2r}"/>

  <material name="${car_name}_accent">
    <color rgba="$(arg accent_color)"/>
  </material>

  <!-- base_link is the rear axle, on the ground: the gym simulates the centre
       of gravity, lr ahead of it, and the bridge converts every pose it publishes
       (odom, tf) back to the rear axle. The meshes are built about the rear axle,
       so they sit at the origin unshifted. Everything on the sprung mass is baked
       into one mesh; only the parts the bridge animates are split out.

       The <collision> box is the gym's contact body (VehicleParameters length x
       width, centred collision_body_center_x = wheelbase/2 ahead of the rear
       axle). It is what raises /<car>/collision, and it is longer than the
       chassis mesh (nose 0.455 m vs 0.428 m ahead of the axle, tail 0.125 m vs
       0.05 m behind it at f1tenth size). Show collision geometry in the viewer
       (RViz "Collision Enabled", Foxglove URDF display mode "Collision") to see
       the footprint a wall contact is judged against. -->
  <link name="${car_name}/base_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_dir}/roboracer_chassis.glb" scale="${s} ${s} ${s}"/>
      </geometry>
    </visual>
    <visual>
      <geometry>
        <mesh filename="${mesh_dir}/roboracer_accent.stl" scale="${s} ${s} ${s}"/>
      </geometry>
      <material name="${car_name}_accent"/>
    </visual>
    <collision>
      <origin xyz="${hit_cx} 0 ${s * 0.06}"/>
      <geometry>
        <box size="${hit_len} ${hit_wid} ${s * 0.12}"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_laser_model" type="fixed">
    <parent link="${car_name}/base_link"/>
    <child link="${car_name}/laser_model"/>
    <origin xyz="${s * 0.266962} ${s * 0.000249} ${s * 0.121636}"/>
  </joint>

  <link name="${car_name}/laser_model">
    <visual>
      <geometry>
        <mesh filename="${mesh_dir}/roboracer_lidar.glb" scale="${s} ${s} ${s}"/>
      </geometry>
    </visual>
  </link>

  <!-- Rear wheels hang off fixed hinge frames like the fronts do, so the bridge
       can publish their rolling rotation (about y, the axle) as a plain TF. -->
  <joint name="base_to_back_left_hinge" type="fixed">
    <parent link="${car_name}/base_link"/>
    <child link="${car_name}/back_left_hinge"/>
    <origin xyz="${s * -0.000833} ${s * 0.130772} ${s * 0.051076}"/>
  </joint>

  <link name="${car_name}/back_left_hinge"/>

  <joint name="back_left_hinge_to_wheel" type="continuous">
    <parent link="${car_name}/back_left_hinge"/>
    <child link="${car_name}/back_left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="${car_name}/back_left_wheel">
    <visual>
      <origin rpy="${align_rl}"/>
      <geometry>
        <mesh filename="${mesh_dir}/roboracer_wheel_rear_left.glb" scale="${s} ${s} ${s}"/>
      </geometry>
    </visual>
  </link>

  <joint name="base_to_back_right_hinge" type="fixed">
    <parent link="${car_name}/base_link"/>
    <child link="${car_name}/back_right_hinge"/>
    <origin xyz="${s * 0.000833} ${s * -0.132075} ${s * 0.050856}"/>
  </joint>

  <link name="${car_name}/back_right_hinge"/>

  <joint name="back_right_hinge_to_wheel" type="continuous">
    <parent link="${car_name}/back_right_hinge"/>
    <child link="${car_name}/back_right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="${car_name}/back_right_wheel">
    <visual>
      <origin rpy="${align_rr}"/>
      <geometry>
        <mesh filename="${mesh_dir}/roboracer_wheel_rear_right.glb" scale="${s} ${s} ${s}"/>
      </geometry>
    </visual>
  </link>

  <!-- The hinge frames are where the bridge publishes the steering rotation, so
       the front wheel meshes are centred on their hubs and spin about z there. -->
  <joint name="base_to_front_left_hinge" type="fixed">
    <parent link="${car_name}/base_link"/>
    <child link="${car_name}/front_left_hinge"/>
    <origin xyz="${s * 0.321733} ${s * 0.132904} ${s * 0.051058}"/>
  </joint>

  <link name="${car_name}/front_left_hinge"/>

  <joint name="front_left_hinge_to_wheel" type="continuous">
    <parent link="${car_name}/front_left_hinge"/>
    <child link="${car_name}/front_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${car_name}/front_left_wheel">
    <visual>
      <origin rpy="${align_fl}"/>
      <geometry>
        <mesh filename="${mesh_dir}/roboracer_wheel_front_left.glb" scale="${s} ${s} ${s}"/>
      </geometry>
    </visual>
  </link>

  <joint name="base_to_front_right_hinge" type="fixed">
    <parent link="${car_name}/base_link"/>
    <child link="${car_name}/front_right_hinge"/>
    <origin xyz="${s * 0.320602} ${s * -0.131600} ${s * 0.050883}"/>
  </joint>

  <link name="${car_name}/front_right_hinge"/>

  <joint name="front_right_hinge_to_wheel" type="continuous">
    <parent link="${car_name}/front_right_hinge"/>
    <child link="${car_name}/front_right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${car_name}/front_right_wheel">
    <visual>
      <origin rpy="${align_fr}"/>
      <geometry>
        <mesh filename="${mesh_dir}/roboracer_wheel_front_right.glb" scale="${s} ${s} ${s}"/>
      </geometry>
    </visual>
  </link>

</robot>
